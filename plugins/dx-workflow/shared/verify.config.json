{
  "guard": [],
  "tests": ["**/test/**", "**/tests/**", "**/__tests__/**", "**/e2e/**", "**/journeys/**", "**/*.{test,spec,e2e}.*", "**/*_test.*", "**/test_*.py", "**/*-snapshots/**"],
  "lanes": {
    "frontend": {
      "files": ["<web app dir>/**/*.{tsx,jsx,vue,svelte,html,css,scss}"],
      "tokens": ["<token CSS file>"],
      "shared": ["<shared component folders, e.g. packages/ui, src/flows>"],
      "sensitive": ["<paths where a mistake costs most, e.g. src/checkout/**, src/auth/**; always merge tier 3>"],
      "checks": [
        { "name": "raw-styles", "run": "node scripts/ui/check-raw-styles.mjs <ui source dirs>" },
        { "name": "types", "run": "<the project's typecheck command>" },
        { "name": "functional", "run": "<the project's e2e command, or ctl reset/start + the journeys + ctl stop>", "timeoutMin": 30 },
        { "name": "look", "run": "npx playwright test e2e/ui-look", "cwd": "<web app dir>", "timeoutMin": 30 },
        { "name": "inspect", "run": "node <tasteInspect path> <url> --out \"$VERIFY_RUN_DIR/inspect\" <--app for app screens>" }
      ]
    },
    "app": {
      "kind": "frontend",
      "platform": "react-native",
      "files": ["<app dir>/**/*.{ts,tsx,js,jsx}", "<app dir>/app.json", "<app dir>/app.config.{js,ts}", "<app dir>/eas.json", "<app dir>/ios/**", "<app dir>/android/**", "<app dir>/assets/**"],
      "native": ["<app dir>/app.json", "<app dir>/app.config.{js,ts}", "<app dir>/eas.json", "<app dir>/ios/**", "<app dir>/android/**"],
      "tokens": ["<theme file, e.g. src/theme.ts>"],
      "shared": ["<shared component folders, e.g. src/components/ui>"],
      "sensitive": ["<sign-in, payments, anything that deletes data>"],
      "checks": [
        { "name": "raw-styles", "run": "node scripts/ui/check-raw-styles.mjs <app source dirs> --platform react-native --spacing-scale <0,4,8,12,16,24,32>" },
        { "name": "types", "run": "npx tsc --noEmit", "cwd": "<app dir>" },
        { "name": "lint", "run": "npx expo lint", "cwd": "<app dir>" },
        { "name": "unit", "run": "npx jest --ci", "cwd": "<app dir>" },
        { "name": "negative", "negative": { "test": "npx jest --ci" } },
        { "name": "functional", "run": "maestro test -e VERIFY_RUN_DIR=\"$VERIFY_RUN_DIR\" .maestro/journeys", "cwd": "<app dir>", "timeoutMin": 30, "ci": false },
        { "name": "look", "run": "node scripts/ui/rn-look.mjs --config e2e/rn-look/screens.json", "cwd": "<app dir>", "timeoutMin": 45, "ci": false }
      ]
    },
    "backend": {
      "files": ["<api dir>/**", "<migrations dir>/**", "<contract file, e.g. openapi.yaml>"],
      "contract": ["<contract file, e.g. openapi.yaml>"],
      "migrations": ["<migrations dir>/**"],
      "shared": ["<modules many endpoints use, e.g. src/db, src/lib>"],
      "sensitive": ["<auth, billing, permissions, data deletion, e.g. src/auth/**, src/billing/**; always merge tier 3>"],
      "checks": [
        { "name": "types", "run": "<typecheck or compile>" },
        { "name": "lint", "run": "<the project's linter>" },
        { "name": "unit", "run": "<unit tests>" },
        { "name": "integration", "run": "<tests against a real database, e.g. docker compose up -d db && pnpm test:int>", "timeoutMin": 30 },
        { "name": "negative", "negative": { "test": "<the command that runs this lane's unit and integration tests>" } },
        { "name": "contract", "run": "<oasdiff breaking <base spec> <spec> --fail-on ERR, or the stack's schema check>" },
        { "name": "migrations", "run": "<on a fresh database: migrate up, down to the base, up again>", "timeoutMin": 15 },
        { "name": "functional", "run": "<ctl reset && ctl start && api journeys; ctl stop>", "timeoutMin": 30 },
        { "name": "security", "run": "<optional: semgrep --config auto --error <api dir>; gitleaks detect; osv-scanner -r .>" }
      ]
    }
  }
}
