{
  "tokens": ["<token CSS file>", "docs/design.md"],
  "shared": ["<shared component folders, e.g. packages/ui, src/flows>"],
  "checks": [
    { "name": "raw-styles", "run": "node scripts/ui/check-raw-styles.mjs <ui source dirs>" },
    { "name": "types", "run": "<the project's typecheck command>" },
    { "name": "functional", "run": "<the project's e2e command, or the verify-<app> journeys>", "timeoutMin": 30 },
    { "name": "look", "run": "npx playwright test e2e/ui-look", "cwd": "<web app dir>", "timeoutMin": 30 },
    { "name": "inspect", "run": "node <tasteInspect path> <url> --out \"$UI_VERIFY_RUN_DIR/inspect\" <--app for app screens>" },
    { "name": "properties", "run": "<optional: property tests for pure helpers, e.g. vitest run src/**/*.property.test.ts>" },
    { "name": "audit", "run": "<optional: pnpm audit --audit-level high>" }
  ]
}
